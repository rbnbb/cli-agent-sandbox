#!/bin/bash
set -euo pipefail
# Install a trusted copy OUTSIDE the mounted workspace before regular use.
workspace=${LAB_WORKSPACE:-"$HOME/lab"}
image=${LAB_IMAGE:-localhost/codex-lab:1}
[[ -d "$workspace" ]] || { echo "Workspace does not exist: $workspace" >&2; exit 1; }
workspace=$(realpath -- "$workspace")
[[ "$workspace" != / && "$workspace" != "$(realpath -- "$HOME")" ]] || { echo 'Refusing to expose the entire home or root directory.' >&2; exit 1; }
[[ "$workspace" != *:* && "$workspace" != *,* ]] || { echo 'Workspace paths containing colon or comma are unsupported.' >&2; exit 1; }
command -v podman >/dev/null || { echo 'Install rootless Podman first; see README.md.' >&2; exit 1; }
remote_container=${LAB_REMOTE_CONTAINER:-codex-lab-remote}
if [[ ${1:-} == --pair ]]; then
  shift
  exec podman exec "$remote_container" codex remote-control pair "$@"
fi
network=slirp4netns:allow_host_loopback=false
if [[ ${1:-} == --offline ]]; then
  network=none
  shift
fi
opts=(--rm --pull=never --userns=keep-id --cap-drop=all
  --security-opt=no-new-privileges --read-only
  --pid=private --ipc=private --uts=private
  --network="$network" --no-hosts
  --pids-limit=1024
  --tmpfs /tmp:rw,nosuid,nodev,size=2g
  --volume "$workspace:/workspace:rw,rprivate"
  --workdir /workspace
  --env HOME=/tmp/lab-home
  --env CODEX_HOME=/workspace/.sandbox-home/codex
  --env JULIA_DEPOT_PATH=/workspace/.sandbox-home/julia
  --env PYTHONUSERBASE=/workspace/.sandbox-home/python
  --env TERM="${TERM:-xterm-256color}")
if [[ "$network" != none ]]; then opts+=(--dns="${LAB_DNS:-1.1.1.1}" --dns-search=.); fi
if [[ -t 0 && -t 1 ]]; then opts+=(-it); else opts+=(-i); fi
# No host environment forwarding, credentials, agent sockets, or engine socket.
entry='set -e; umask 077; mkdir -p /tmp/lab-home/.juliaup/bin /workspace/.sandbox-home/codex; ln -s /opt/julia/bin/julia /tmp/lab-home/.juliaup/bin/julia; exec "$@"'
case ${1:-} in
  --remote)
    shift
    [[ "$network" != none ]] || { echo 'Remote control requires network access.' >&2; exit 2; }
    opts+=(--name "$remote_container" --hostname codex-lab)
    # Foreground remote-control does not expose the managed control socket.
    # Start the managed daemon, then keep its container alive and monitor it.
    remote_entry=$(cat <<'REMOTE'
set -euo pipefail
cleanup() { codex remote-control stop >/dev/null 2>&1 || true; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
codex -c 'sandbox_mode="danger-full-access"' -c 'approval_policy="never"' remote-control start "$@"
printf 'Remote container is running. In another host terminal: codex-lab --pair\n'
while sleep 5; do
  codex app-server daemon version | python3 -c 'import json,sys; s=json.load(sys.stdin); sys.exit(0 if s.get("status") == "running" else "Remote daemon stopped")'
done
REMOTE
)
    command=(/bin/bash -c "$remote_entry" remote-supervisor "$@");;
  --shell) shift; command=(/bin/bash "$@");;
  --run) shift; if (( $# == 0 )); then echo '--run needs a command' >&2; exit 2; fi; command=("$@");;
  --login) shift; command=(codex login --device-auth "$@");;
  *) command=(codex --no-daemon --dangerously-bypass-approvals-and-sandbox -C /workspace "$@");;
esac
exec podman run "${opts[@]}" "$image" /bin/bash -c "$entry" sandbox-init "${command[@]}"
